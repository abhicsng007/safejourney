# SafeJourney agent-api base URL
VITE_API_URL=http://localhost:8080

# Optional: a MapTiler / Google style key for prettier maps. If unset, a keyless OSM
# raster style is used so the app renders with zero setup.
VITE_MAP_STYLE_URL=

# --- Firebase Cloud Messaging (optional) ---
# Enables "app-closed" web push. All values come from your Firebase project:
#   Firebase console → Project settings → General → Your apps → Web app (SDK config).
# Leave blank to run without push (alerts still show in-app).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Cloud Messaging → Web configuration → "Web Push certificates" → Key pair (VAPID public key).
VITE_FIREBASE_VAPID_KEY=
