# --- Google Cloud / Gemini ---
# Option A: Vertex AI (recommended for the hackathon; uses ADC / service account)
GCP_PROJECT=
GCP_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
# Option B: Gemini API key (simplest for local dev) — leave Vertex off and set this
# GOOGLE_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
# For submission set a hackathon-eligible model, e.g.:
# GEMINI_MODEL=gemini-3.5-flash

# --- Maps Platform (optional; falls back to synthetic routes/places if unset) ---
GOOGLE_MAPS_API_KEY=

# --- Firestore (optional; falls back to in-memory if unset) ---
# USE_FIRESTORE=true
# FIRESTORE_PROJECT=your-project-id

# --- Pub/Sub (background monitoring fan-out) ---
PUBSUB_TOPIC_EVALUATE=trip-evaluate

# --- FCM push (optional; logs alerts instead if disabled) ---
FCM_ENABLED=false

# --- Monitoring behaviour ---
DEFAULT_INTERVAL_S=180
MIN_INTERVAL_S=45
MAX_INTERVAL_S=900
CORRIDOR_OFFSET_M=350
HAZARD_CACHE_TTL_S=300
